# PostgreSQL Veritabanı Yapılandırması
POSTGRES_USER=kampanya_user
POSTGRES_PASSWORD=kampanya_pass
POSTGRES_DB=kampanya_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Bağlantı URL'i
DATABASE_URL=postgresql://kampanya_user:kampanya_pass@localhost:5432/kampanya_db

# Uygulama Port ve Ortam Ayarları
PORT=8000
ENVIRONMENT=development
